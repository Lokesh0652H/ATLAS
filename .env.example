# ==============================================================================
# ATLAS — Environment Configuration Template
# Copy this file to .env in local development. Never commit real keys.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=true
ATLAS_SECRET_KEY=change_me_to_a_secure_random_hex_key_32_bytes
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL with pgvector)
# Standalone SQLite fallback: sqlite:///./atlas_dev.db
DATABASE_URL=sqlite:///./atlas_dev.db
# Production: postgresql://atlas_user:atlas_password@localhost:5432/atlas_db

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Storage Path for Uploaded Documents
STORAGE_LOCAL_PATH=./storage/uploads

# Embedding Provider Configuration
# Supported providers: "local" (zero external API needed), "openai", "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Provider Configuration
# Supported providers: "local" (in-memory reasoning engine), "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=local
LLM_MODEL_NAME=atlas-local-reasoner

# Optional Provider API Keys (Leave blank to use robust local processing)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Web Search Provider Configuration
# Supported providers: "duckduckgo", "tavily", "serper"
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
